# Public sample site works without these values. Copy to .env.local for local development.
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/manage
ADMIN_USER_IDS=
# Public Vercel Blob store. Local development uses this read/write token.
BLOB_READ_WRITE_TOKEN=
# Hosted OIDC may instead use BLOB_STORE_ID and VERCEL_OIDC_TOKEN supplied by Vercel.
# Enable after database migrations, admin configuration, and launch content are ready.
BOOKINGS_ENABLED=false
